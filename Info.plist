<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<!-- 应用身份、通用设备支持及 USB 文件共享。 -->
<key>CFBundleDisplayName</key><string>MioLib</string>
<!-- 1.12.0 逐本保存网页阅读模式，支持直接退出与后台重试缓存。 -->
<!-- 1.15.4 注释小窗按注释文字的高度排版。 -->
<key>CFBundleShortVersionString</key><string>1.15.4</string>
<key>CFBundleVersion</key><string>28</string>
<!-- 用户确认缓存后由 iOS 26 及更新系统继续下载，任务标识按每次缓存队列生成。 -->
<key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.miolib.reader.web-cache.*</string></array>
<key>UIBackgroundModes</key><array><string>processing</string></array>
<key>LSRequiresIPhoneOS</key><true/>
<key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>
<key>UIFileSharingEnabled</key><true/>
<key>LSSupportsOpeningDocumentsInPlace</key><true/>
<!-- WKWebView 原生“保存图像”会访问系统相册；缺少用途说明时 iOS 会直接终止应用。 -->
<key>NSPhotoLibraryAddUsageDescription</key><string>将你在网页中选择的图片保存到系统相册。</string>
<!-- 兼容 WebKit 使用照片读写授权的系统版本，只有用户主动保存图片时才触发系统询问。 -->
<key>NSPhotoLibraryUsageDescription</key><string>在你选择保存网页图片时访问系统相册。</string>
<!-- Calibre 使用局域网；仅网页浏览器允许用户主动输入的 HTTP 网站。 -->
<key>NSLocalNetworkUsageDescription</key><string>连接你电脑上的 Calibre 内容服务器，浏览书库并下载所选电子书。</string>
<key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/><key>NSAllowsArbitraryLoadsInWebContent</key><true/></dict>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
<key>UISupportedInterfaceOrientations~ipad</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationPortraitUpsideDown</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
<!-- 注册已有文档类型，接收其他应用传入的原始文件。 -->
<key>CFBundleDocumentTypes</key><array><dict>
<key>CFBundleTypeName</key><string>电子书与书库备份</string>
<key>CFBundleTypeRole</key><string>Viewer</string>
<key>LSHandlerRank</key><string>Alternate</string>
<key>LSItemContentTypes</key><array><string>org.idpf.epub-container</string><string>public.plain-text</string><string>com.adobe.pdf</string><string>com.miolib.mobi</string><string>com.miolib.azw3</string><string>com.miolib.backup</string></array>
</dict></array>
<!-- MOBI / AZW3 为导入类型，备份为应用自有导出类型。 -->
<key>UTImportedTypeDeclarations</key><array>
<dict><key>UTTypeIdentifier</key><string>com.miolib.mobi</string><key>UTTypeDescription</key><string>Mobipocket 电子书</string><key>UTTypeConformsTo</key><array><string>public.data</string><string>public.content</string></array><key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>mobi</string></array><key>public.mime-type</key><string>application/x-mobipocket-ebook</string></dict></dict>
<dict><key>UTTypeIdentifier</key><string>com.miolib.azw3</string><key>UTTypeDescription</key><string>Kindle KF8 电子书</string><key>UTTypeConformsTo</key><array><string>public.data</string><string>public.content</string></array><key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>azw3</string></array><key>public.mime-type</key><string>application/vnd.amazon.ebook</string></dict></dict>
</array>
<key>UTExportedTypeDeclarations</key><array><dict><key>UTTypeIdentifier</key><string>com.miolib.backup</string><key>UTTypeDescription</key><string>MioLib 书库备份</string><key>UTTypeConformsTo</key><array><string>public.zip-archive</string></array><key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>miolib</string></array></dict></dict></array>
</dict></plist>
